import from "@jac/mobui" { StyleSheet }

glob DARK: dict = {
    "bg": "#f4f7f6",
    "surface": "#ffffff",
    "border": "#e2e9e6",
    "text": "#17332d",
    "muted": "#71847f",
    "accent": "#087f68",
    "accentText": "#ffffff"
};


def:pub buildStyles(C: dict) -> any {
    return StyleSheet.create({
        "screen": {"flex": 1, "backgroundColor": C["bg"]},
        "screenContent": {
            "flexGrow": 1,
